# Copy to `.env` for local development.

# Base URL of the Cloudflare Worker that backs share permalinks.
#
#   - Leave empty → only inline-link sharing is available; Permalink tab in
#     the Share dialog is disabled with a tooltip.
#   - Production:  https://share.nkido.cc
#   - Local dev:   http://localhost:8787  (run `bun run dev` in web/share-api)
#   - Self-host:   your own deployed Worker URL
#
# This var must start with PUBLIC_ to be exposed to the SvelteKit client.
PUBLIC_SHARE_API_BASE=
