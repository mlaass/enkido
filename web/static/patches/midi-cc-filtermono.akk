// Monophonic MIDI lead with live CC and pitch-bend control.
//
// Plug in a keyboard and play. Five external controls are mapped below:
//   * CC 1  -> filter cutoff
//   * CC 2  -> filter resonance
//   * CC 3  -> oscillator pulse width (PWM)
//   * CC 4  -> glide / portamento time
//   * Pitch-bend wheel -> pitch in semitones (+/- 2 by default)
//
// `midi_cc(name, {...})` is a compile-time directive (prd-midi-input §4.8)
// that routes incoming controller messages straight into `param()` slots via
// EnvMap, so there is no audio-thread work and no extra opcode. The sliders
// below act as the fallback default when nothing is sending on those CCs.
//
// CC numbers vary per controller. Common conventions:
//   CC 1  = mod wheel (universal)
//   CC 2  = breath / Korg-style joystick Y-axis
//   CC 71 = "resonance" (GM2 spec, only sent by mappable knobs)
//   CC 74 = "brightness/filter" (GM2 spec, same caveat)
// If a route does not move, change its `cc:` to match what your gear sends.

bpm = 120

cutoff       = param("cutoff",     1200, 10, 8000)
res          = param("res",         0.7,   0,    12)
pitch_bend   = param("pitch_bend",    0,  -2,    2)   // semitones
pwm          = param("pwm",         0.8,   0,    1)
glide_time   = param("glide_time",    0.05,  0,    0.5)

// Map raw 0..127 CC values into each param's full audible range.
midi_cc("cutoff",     {cc: 1, min: 10, max: 8000})
midi_cc("res",        {cc: 2, min:  0, max:   12})
midi_cc("pwm",        {cc: 3, min:  0, max:    1})
midi_cc("glide_time", {cc: 4, min:  0, max:  0.5})

// `pb: true` picks up the 14-bit pitch-bend message (0xEn). The default PB
// range is -1..+1, so we remap it to semitones for a musical +/- 2 ST whammy.
midi_cc("pitch_bend", {pb: true, min: -2, max: 2})

// Convert pitch-bend in semitones to a frequency multiplier. Twelve semitones
// equal one octave, so `2^(bend/12)` is the standard scaling.
fn bend_mult() -> pow(2, pitch_bend / 12)

// Mono lead: glided saw + sub square (one octave down), both with PWM,
// through a resonant low-pass and an ADSR scaled by smoothed velocity.
// `trig` re-syncs the oscillator phase on each new note.
fn lead(freq, gate, vel, trig) ->{
    v = interp(vel, 0.002) // velocity smoothed over 2ms to avoid pops
    saw_pwm(glide(freq, glide_time) * bend_mult(), pwm, _, trig) * 0.55
        + sqr_pwm(glide(freq, glide_time) * bend_mult() * 0.5, pwm, _, trig) * 0.3
        |> lp(@, cutoff, res)
        |> @ * adsr(gate, 0.01, 0.15, 0.75, 0.35) * v
}

// Monophonic chain: take the latest MIDI note, run it through `lead`,
// then a soft saturator for some grit before output.
midi()
    |> lead(@.freq, @.gate, @.vel, @.trig)
    |> saturate(@, 2)
    |> out(@)
