// Gated Unison Pad
// `unison()` composes with `poly()`: wrap unison in a 3-arg instrument and
// hand it to `poly`. Each chord note triggers its own detuned unison cluster,
// so a 4-voice chord with `voices: 4` unison runs up to 16 oscillators at
// once. CPU scales with `poly_voices * unison_voices`: keep both modest.

bpm = 135

fn pad_voice(freq, gate, vel, ext) ->
    saw(freq, ext.phase) * adsr(gate, 0.5, 0.6, 0.7, 1.2) * vel    
    |> lp(@, 2800)
    
    

// fat(): a normal 3-arg poly instrument that fans each note into 4 detuned
// unison voices. `unison` always returns stereo, so `poly` will too.
fn fat({freq, gate, vel}) ->
    unison(freq, gate, vel, pad_voice,
           voices: 3, detune: 0.3, width: .7, phase: 0.2)

c"Cmaj9 Am11@2 Fmaj7 G9@2".slow(2).transpose(-12)
    |> poly(@, fat, _, 3) * 0.2 * interp(v"[0 1 0 1 1 1]", 0.005)
    |> reverb(@, 0.75, 0.6, ..{wet: 0.1})
    |> out(@)