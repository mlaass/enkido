// 2-operator FM stab: a sine carrier reads a sine modulator on its
// frequency input. The modulator's AR envelope drops the FM index
// over time, so the attack is bright and the tail decays to a clean
// sine. The basis of every DX7 Rhodes patch.

bpm = 100

trig = trigger(1)
mod_env = ar(trig, 0.001, 0.7)
mod = sine( 220) * mod_env * 800
sine( 220 + mod) * ar(trig, 0.005, 1.4) * 0.3
    |> reverb(@, 0.5, 0.5, ..{dry: 0.7, wet: 0.3})
    |> out(@)
