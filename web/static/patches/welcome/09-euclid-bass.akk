// Euclidean rhythm: `euclid(hits, steps)` spreads N hits as evenly
// as possible over M steps. (3,8) is the tresillo found in Cuban,
// West African, and bluegrass music. Try (5,8) or (7,16).

bpm = 110

s"bd ~ ~ ~" |> out(@)

sine( 55) * ar(euclid(3, 8), 0.005, 0.4) * 0.7
    |> saturate(@, 3)
    |> lp(@, 500)
    |> out(@)
