// Amplitude modulation: multiplying two sines creates sum-and-
// difference frequencies. Audio-rate modulation produces metallic,
// bell-like sidebands. Try non-integer ratios for inharmonic tones.

bpm = 100

carrier = sine( 440)
mod = sine( 207)
(carrier * mod * 0.25)
    |> reverb(@, ..{dry: .7, wet: .3}) 
    |> out(@)
