// SoundFont: plays a melody through the built-in General MIDI bank.
// `soundfont(pattern, "gm", preset)` routes pattern events into the
// SF2 synth: gate, freq, and velocity are extracted from the events.
//
// Preset 0 is Acoustic Grand Piano in the GM standard. Preset 1 is Bright
// Acoustic Piano, layered 2 octaves below for body.

bpm = 100

melody = n"c4 eb4 g4 c5 ~ g4 eb4 c4 d4 f#4 a4 d5 ~ a4 f#4 d4 eb4 g4 b4 eb5 ~ b4 g4@2 eb4@2 c4@2 ~@8"

// Lead piano: dry voice + small reeverb tail
melody
  |> soundfont(@, "gm", 0) * 0.3
  |> pan(@, 0.25)
  |> reverb(@, 0.65, 0.4, ..{wet:0.15}) 
  |> out(@)

// slowed down sub-octave bright piano, delayed by a beat for a layered feel.
melody.slow(2)
  |> transpose(@, -24)
  |> soundfont(@, "gm", 1) * 0.22
  |> delay(@, spb, 0,0,0.7)
  |> pan(@, -0.25)
  |> dattorro(@)
  |> out(@)