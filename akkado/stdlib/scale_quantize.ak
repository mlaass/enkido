// ----------------------------------------------------------------------------
// User-defined scales (PRD §4.6) — arity-3 overloads. `root` is a note
// name string ("d2") or a MIDI number; `ivals` a semitone interval
// array. key_deltas() is a compile-time builtin (C++ const-eval) that
// turns (root, intervals) into the 12-entry nearest-tone delta table.
// No validation by design — out-of-range intervals coerce mod 12
// (live-coding coerce-don't-fail; audit 2026-07-04).
// ----------------------------------------------------------------------------

// key_deltas resolves the root itself (note-name string or number,
// octave ignored). Both bodies bind the compile-time pieces to LOCALS
// before the nested call: codegen clears param_literals_ around a
// nested call's argument list, so key_deltas(root, ...) / note_num(root)
// can only see `root`'s caller literal from body-statement position.
fn key(events: Stream, root, ivals) -> {
    deltas = key_deltas(root, ivals)
    key_q(events, deltas)
}
fn scale(events: Stream, root, ivals) -> {
    rm = note_num(root)
    scale_q(events, rm, len(ivals), ivals)
}

