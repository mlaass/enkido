//     cd web && bun run scripts/generate-scale-quantize.ts
//
// Implements docs/prd-scale-quantize.md §4.4 (`scale`, degree mapping)
// and §4.5 (`key`, 12-TET quantization). Both are the outer `match`
// themselves — the literal-only constraint of match dispatchers (see
// scales.ak header) precludes delegating to `scale_intervals(name)`
// at runtime, so each branch inlines its own literal interval array.
//
// Catalog: 12 chromatic roots × 8 scale types.
// `key` strings are octave-agnostic — an octave digit is accepted and
// ignored ("d2:minor" == "d:minor"). `scale` strings use the octave
// digit (e.g. `"d3:minor"`), with a missing digit defaulting to
// octave 3 per PRD §4.3.

// ----------------------------------------------------------------------------
// Helper fns — factored arithmetic shared across branches
// ----------------------------------------------------------------------------
//
// `snap` round-halves-up a (possibly fractional) MIDI note to the nearest
// integer. `pc12` reduces a (possibly negative) MIDI note to its pitch
// class 0..11, two `fmod`s to handle negative inputs symmetrically.
//
// `key_q` / `scale_q` carry the entire per-event arithmetic ONCE; every
// match branch is a short call passing literal tables. The match-dispatcher
// literal-only constraint applies to the match SCRUTINEE (the name string),
// not to delegating the arithmetic — after the match folds to one branch,
// what remains is a plain fn call with literal args, and closures capture
// fn params exactly like stdlib `transpose` does. This keeps the embedded
// stdlib small: per-compile parse cost scales with file size.

fn snap(n) -> floor(n + 0.5)
fn pc12(n) -> fmod(fmod(n, 12) + 12, 12)

fn key_q(events: Stream, deltas) -> event_map(events, (e) -> {note: snap(e.note) + deltas[pc12(snap(e.note))]})
fn scale_q(events: Stream, rm, k, ivals) -> event_map(events, (e) -> {note: rm + floor(snap(e.note) / k) * 12 + ivals[snap(e.note) - floor(snap(e.note) / k) * k]})

